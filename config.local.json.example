{
  "//": "Draft Sidekick local parameter overrides. Copy this file to `config.local.json` (gitignored) and delete the keys you do not want to change — anything absent keeps its default. Keys beginning with `//` are comments and are ignored by the loader. An unrecognised key or a wrong-typed value is a startup error, not a silent no-op. Changes take effect on server restart.",
  "// source-of-truth": "Defaults live in packages/shared/src/config/parameters.ts. Every value below is that file's default. Provenance tags: [PRD] the PRD states this number; [filled] the PRD names the parameter but no number; [added] an implementation knob the PRD does not name.",

  "// --- Sync cadence and API budget ---": "",
  "// pollIntervalMs": "[PRD AS-5 / AC-9] How often the complete Sleeper pick list is re-fetched, in ms.",
  "pollIntervalMs": 1000,
  "// apiBudgetPerMin": "[PRD AS-5 / AC-10] Ceiling on Sleeper requests per minute from one instance.",
  "apiBudgetPerMin": 120,
  "// initialIngestTimeoutMs": "[PRD AS-5 / AC-1] Budget for the full initial ingest at attach, in ms.",
  "initialIngestTimeoutMs": 10000,
  "// pickReflectionLatencyMs": "[PRD AS-5 / AC-11, AC-31] Budget from a pick landing in a poll response to it showing in every view, in ms.",
  "pickReflectionLatencyMs": 3000,
  "// resyncTimeoutMs": "[PRD AS-5 / AC-19] Budget for a manual Re-sync to rebuild the whole board, in ms.",
  "resyncTimeoutMs": 5000,

  "// --- ECR / ADP snapshots ---": "",
  "// snapshotStalenessWarningHours": "[PRD AS-5 / AC-22] Age past which the pre-draft check warns a snapshot is stale.",
  "snapshotStalenessWarningHours": 24,
  "// adpPoolTeamSizes": "[PRD AS-6 / AC-24] Team-count pools the ADP source publishes; the nearest one to your league is used, ties resolving toward the larger.",
  "adpPoolTeamSizes": [8, 10, 12, 14],
  "// snapshotFetchTimeoutMs": "[added] Budget, in ms, for the whole third-party snapshot load at attach — the DynastyProcess crosswalk download plus the FantasyPros ECR and Fantasy Football Calculator ADP fetches together. A source that overruns it is abandoned, and attach continues with the pre-draft check's 'no rankings loaded' / 'no ADP' warnings rather than hanging. Raise it on a slow connection; lower it to fail over to a cached crosswalk sooner.",
  "snapshotFetchTimeoutMs": 15000,

  "// --- Insight refresh ---": "",
  "// insightRefreshLatencyMs": "[PRD AS-5 / AC-46, AC-53] Budget from a burst's final pick to every insight reflecting it, in ms.",
  "insightRefreshLatencyMs": 5000,
  "// burstDebounceMs": "[added] Quiet period after the last observed new pick before the recompute cascade fires, so a burst recomputes once rather than once per pick.",
  "burstDebounceMs": 400,

  "// --- Need vectors ---": "",
  "// flexEligiblePositions": "[PRD §9 Terms] Positions that may occupy a FLEX slot. Each unfilled FLEX slot contributes 1/(this length) to each listed position.",
  "flexEligiblePositions": ["RB", "WR", "TE"],

  "// --- Opponent tendency profiles ---": "",
  "// tendencyColdStartPicks": "[PRD AS-2 / AC-39] Picks a team must make in this draft before its profile leaves neutral priors.",
  "tendencyColdStartPicks": 3,
  "// tendencyPositionalNudgeClamp": "[added] Bound on the observed-minus-expected positional-share nudge in the tendency-bending formula. Raise it to let a team's revealed positional bias move its predicted distribution further.",
  "tendencyPositionalNudgeClamp": 0.5,

  "// --- Monte Carlo survival simulation ---": "",
  "// simUniverseSize": "[filled] Top-N available players by ADP that form the simulation universe, before extension to cover every displayed candidate row.",
  "simUniverseSize": 40,
  "// monteCarloRunCount": "[filled] Independent simulation runs per recompute. Turn this down first if recomputes miss the latency budget on your machine.",
  "monteCarloRunCount": 2000,
  "// reachAdjustmentPerPick": "[added] How far one pick of a team's average reach shifts a player's effective within-position ADP rank when weighting the player draw.",
  "reachAdjustmentPerPick": 1,
  "// kdstEarlyPickWindow": "[PRD FR-8, amended 2026-08-27] How many picks before the hard K/DST deadline a simulated team may start spending picks on K/DST (probability unfilled/remaining inside the window, 1 at the deadline). 0 restores the deadline-only rule. Tune against `npm run trace:calibrate`.",
  "kdstEarlyPickWindow": 4,
  "// survivalBandLikelyGoneMax": "[PRD AS-5 / AC-44] Survival probability (0..1) at or below which a player reads as 'likely gone'.",
  "survivalBandLikelyGoneMax": 0.25,
  "// survivalBandLikelyAvailableMin": "[PRD AS-5 / AC-44] Survival probability (0..1) at or above which a player reads as 'likely available'.",
  "survivalBandLikelyAvailableMin": 0.75,

  "// --- Candidate list and recommendation ---": "",
  "// candidateListDefaultRows": "[PRD AS-5 / AC-49] Rows shown before any lookahead-highlight extension.",
  "candidateListDefaultRows": 8,
  "// valueThresholdAdpPicksEarlier": "[PRD AS-5 / AC-51] How many picks earlier than the current pick a player's ADP must be for the reason line to read 'value'.",
  "valueThresholdAdpPicksEarlier": 10,
  "// nearTieSurvivalPct": "[PRD AS-5 / AC-52] Survival gap, in percentage points, inside which two candidates count as within noise.",
  "nearTieSurvivalPct": 5,
  "// nearTieEcrRanks": "[PRD AS-5 / AC-52] ECR-rank gap inside which two candidates count as within noise.",
  "nearTieEcrRanks": 3,
  "// planTotalTooCloseEcrRanks": "[PRD AS-5 / AC-55, AC-58] ECR-rank gap inside which two lookahead plan totals are too close to separate.",
  "planTotalTooCloseEcrRanks": 3,
  "// lookaheadMaxPicks": "[PRD AS-2 / AC-60] How many of your own picks the lookahead ever reaches ahead.",
  "lookaheadMaxPicks": 2,
  "// endgameKdstBufferPicks": "[PRD FR-9, amended 2026-08-27] The endgame guard's slack: the highlight moves to the top available K/DST once your remaining picks are at or below your unfilled K/DST starting slots plus this buffer. The buffer absorbs one ignored recommendation.",
  "endgameKdstBufferPicks": 1,
  "// benchPositionHeadroom": "[PRD FR-9/FR-10, amended 2026-08-27] The bench phase's cap for non-FLEX-eligible positions: once your starters are full, such a position stops entering plans or the highlight when you already roster (its starting slots + this) of it — a 1-QB league caps at 2 QBs. FLEX-eligible positions are never capped.",
  "benchPositionHeadroom": 1,

  "// --- Multiple instances and rate limiting ---": "",
  "// secondInstanceBackoffFactor": "[filled] Each additional live Sidekick instance multiplies the poll interval: pollIntervalMs * (1 + this * otherLiveInstances).",
  "secondInstanceBackoffFactor": 0.5,
  "// rateLimitBackoffMaxMs": "[added] Ceiling on the reactive back-off applied after an HTTP 429 from Sleeper.",
  "rateLimitBackoffMaxMs": 10000,

  "// --- Player game logs ---": "",
  "// gamelogSeasonsToCache": "[filled] Seasons of nflverse data the offline `npm run prep:nflverse` step caches.",
  "gamelogSeasonsToCache": 3
}
